
# Restricted worker login (products + premium bundles only). Disabled if unset.
WORKER_PASSWORD=
t, and it has a working default.

# Shared password for /admin (demo-only auth — see middleware.ts).
ADMIN_PASSWORD=appelectric-admin

# New-order admin email notification (lib/server/email.ts). Sent via Gmail
# SMTP — leave unset to skip sending (a warning is logged instead; the
# in-panel bell/badge and SweetAlert popup still work without this).
# SMTP_USER is the Gmail address that SENDS the email; create an "App
# Password" for it at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification on that account) and use it as SMTP_PASS — NOT the
# regular Gmail login password.
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Where the notification email is sent (defaults to this if unset).
ADMIN_NOTIFY_EMAIL=okpedi@gmail.com
